{
  "name": "uniquedomains-nodejs",
  "private": true,
  "description": "Node SDK and CLI for the Unique Domains API.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniqueDomains/nodejs.git"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run build --workspace packages/sdk && npm run build --workspace packages/cli",
    "typecheck": "tsc -p packages/sdk --noEmit && tsc -p packages/sdk/typetests && tsc -p packages/cli --noEmit",
    "test": "node --test packages/*/test/*.test.mjs scripts/test/*.test.mjs",
    "check:text": "node scripts/check-text.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
