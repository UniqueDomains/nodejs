{
  "name": "@uniquedomains/cli",
  "version": "0.1.0",
  "description": "The Unique Domains API from the command line: domain names, words, TLDs, registrar prices, the domain market, trends and the agenda.",
  "license": "MIT",
  "author": "Unique Domains (https://unique.domains)",
  "homepage": "https://unique.domains/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniqueDomains/nodejs.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/UniqueDomains/nodejs/issues",
  "keywords": [
    "domain-names",
    "domains",
    "whois",
    "tld",
    "registrar",
    "cli",
    "unique-domains"
  ],
  "type": "module",
  "bin": {
    "ud": "dist/bin.js",
    "uniquedomains": "dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/copy-assets.mjs cli && tsup",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@uniquedomains/sdk": "0.1.0"
  }
}
