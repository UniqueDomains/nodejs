{
  "name": "@uniquedomains/domain-appraisal",
  "version": "0.2.0",
  "description": "Domain appraisal for Node.js: what similar names sold for, as a count and a median, free with no key. The estimated value with a key.",
  "license": "MIT",
  "author": "Unique.domains (https://unique.domains)",
  "homepage": "https://unique.domains/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniqueDomains/nodejs.git",
    "directory": "packages/domain-appraisal"
  },
  "bugs": "https://github.com/UniqueDomains/nodejs/issues",
  "keywords": [
    "domain-appraisal",
    "domain-value",
    "appraisal",
    "comparable-sales",
    "domain",
    "unique-domains"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ud-appraise": "dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/copy-assets.mjs domain-appraisal && tsup",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@uniquedomains/sdk": "0.2.0"
  }
}
