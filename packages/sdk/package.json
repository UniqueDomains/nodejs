{
  "name": "@uniquedomains/sdk",
  "version": "0.2.0",
  "description": "Typed Node client for domain data: is a name taken, its WHOIS record, nine registrars' prices, renewal traps, auctions and sales totals. 62 of 87 operations need no key.",
  "license": "MIT",
  "author": "Unique Domains (https://unique.domains)",
  "homepage": "https://unique.domains/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniqueDomains/nodejs.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/UniqueDomains/nodejs/issues",
  "keywords": [
    "domain-names",
    "domains",
    "whois",
    "tld",
    "registrar",
    "sdk",
    "openapi",
    "unique-domains"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/copy-assets.mjs sdk && tsup",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "openapi-fetch": "0.17.0"
  }
}
